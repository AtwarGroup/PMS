{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child($uid).child('managerChain').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
      }
    },
    "tasksByUser": {
      "$ownerUid": {
        ".read": "auth != null && (auth.uid === $ownerUid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child($ownerUid).child('managerChain').child(auth.uid).val() === true)",
        "$taskKey": {
          ".write": "auth != null && (auth.uid === $ownerUid || root.child('users').child(auth.uid).child('role').val() === 'admin' || data.child('createdByUid').val() === auth.uid || newData.child('createdByUid').val() === auth.uid || root.child('users').child($ownerUid).child('managerChain').child(auth.uid).val() === true)"
        }
      }
    },
    "createdTaskIndex": {
      "$creatorUid": {
        ".read": "auth != null && (auth.uid === $creatorUid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "$taskKey": {
          ".write": "auth != null && (auth.uid === $creatorUid || root.child('users').child(auth.uid).child('role').val() === 'admin')"
        }
      }
    },
    "notificationsByUser": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$notificationId": {
          ".write": "auth != null"
        }
      }
    },
    "financial_manager_tasks": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": false
    },
    "tasks": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      ".write": false
    }
  }
}